{{-
##
    THE BEST EVER DISCORD ACTIVITY HONORIFIC TEMPLATE OUT OF DENTON
    https://github.com/pearstopher/discord-activity-honorific-template

    The default configuration functions identically to "Spotify 2"

    by pearstopher@discord / Ane Mora@Famfrit
##


config = {
##
    CONFIGURATION
##


# choose the maximum number of characters of song info to display
max_chars: 30,
# *honorific supports a max of 32 total
# *20 is a safe max with timers on and occasional 10+ minute songs
# *30 is a safe max with the default pre- and post-display ♪ chars


# choose text to display to the ♪left and right♪ of the song info
pre_display: "♪",
post_display: "♪",
# * not included in max_chars

# or show progress timers for each song instead
display_timers: false,
# *adds 10 characters when true (M:SS_ and _M:SS)


# choose to display all artists or just the first artist name
all_artists: true,

# choose a custom message to display at the start of each cycle
enable_message: false,
custom_message: "Listening to Spotify",


# choose how often to update scrolling/bouncing text in seconds
update_interval: 3,
# *seems to work as low as 2s before it breaks for synced pairs
# *tested with Lightless

# choose how often to update text that fits without padding
static_interval: 9,
# *must be a multiple of update_interval if using timers


# choose between infinite scroll and alternate display
infinite_scroll: false,
# *if true, display scrolls repeating artist and track name indefinitely
# *if false, alternates between artist and track names individually

# (infinite scroll only) choose how many characters to scroll at a time
chars_at_a_time: 2,

# (alternate only) choose to pad short text with whitespace up to max_width
padding: false,

# (alternate only) choose what type of elipses to display ("...", "", "…", "")
elipses: "...",


# choose what type of character replacement you prefer if any
char_replace_type: "none",
# "none" =  PRO: standard font, supports all special characters
#           CON: not fixed width, updates change title size
#
# "block" = PRO: true fixed width display
#           CON: only supports uppercase letters and numbers
#
# "mono" =  PRO: supports upper- and lower-case letters
#           CON: not truly monospace as spaces are slightly too wide
#

# (block text only) replace spaces with empty block ■ if true
block_spaces: false


##
    DON'T EDIT BELOW THIS LINE UNLESS YOU KNOW WHAT YOU'RE DOING

    In which case I'd love to see a pull request with your additions
    https://github.com/pearstopher/discord-activity-honorific-template
##
}
c = config



##
    CROSS PLUGIN COMPATIBILITY
##


# determine which plugin is being used
discord = ! Activity.Popularity

# get plugin specific template variables
ActivityElapsedTotalSeconds = discord ? Activity.Elapsed.TotalSeconds : Context.SecsElapsed
# Context.SecsElapsed does not match Activity.Elapsed and is less reliable
# - It tracks the script context and is not related to Spotify at all
# - It resets to 0 whenever you edit the template, if you pause a song, etc.
ActivityDurationTotalSeconds = (discord ? Activity.Duration.TotalSeconds : Activity.DurationMs / 1000) | math.floor
ActivityArtist = discord ? Activity.Artists[0] : Activity.Artists[0].Name
if c.all_artists
    for artist in Activity.Artists offset: 1
        ActivityArtist = ActivityArtist + ", " + discord ? artist : artist.Name
    end
end
ActivityTrackTitle = discord ? Activity.TrackTitle : Activity.Name

# no template variables below this line



##
    FUNCTIONS
##


# replace characters with monospaced or XIV block letters
func replace_chars(title)

    alphabet = "0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ?abcdefghijklmnopqrstuvwxyz"
    mono = "０１２３４５６７８９　ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺ？ａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ"
    block = "　"

    if c.char_replace_type == "none"
        ret title
    else if c.char_replace_type == "mono"
        chars = mono
    else if c.char_replace_type == "block"
        chars = block
        title = string.upcase title
        if c.block_spaces
            title = title | string.replace " " "■"
        end
    end

    # perform the character replacement
    result = ""
    for char in title
        index = alphabet | string.index_of char
        if index >= 0 && index < (chars | string.size)
            result = result + (chars | string.slice index 1)
        end
    end
    ret result
end


# (alternate display) function to determine number of segments
func seg_count(str)
    len = str | string.size
    dotlen = c.elipses | string.size

    # segments must remain within max_chars including elipses
    if len <= c.max_chars
        ret 1
    else if len <= 2*(c.max_chars - dotlen)
        ret 2
    else
        ret (len - 2*(c.max_chars - dotlen)) / (c.max_chars - 2*dotlen) | math.ceil + 2
    end
end


# (alternate display) function to get the correct segment text
func get_segment(str, space, seg, segmax, sec, secmax)
    len = str | string.size
    dotlen = c.elipses | string.size

    # one segment display
    if segmax == 1
        if (! c.padding) || (len == c.max_chars)
            ret str
        else
            # create before/after padding bounce
            pad_with = space*(c.max_chars - len)
            interval = (secmax / 3) | math.floor
            if (sec >= interval) && (sec < interval * 2)
                ret pad_with + str
            else
                ret str + pad_with
            end
        end

    # first segment of a 2+ segment display
    # (timer is adjusted so that seg exceeds segmax to force repeat for 2-segment displays)
    else if seg == 1 || seg > segmax
        ret str | string.slice 0 (c.max_chars - dotlen) | string.append c.elipses

    # last segment of a 2+ segment display
    else if seg == segmax
        ret c.elipses | string.append (str | string.slice (len - (c.max_chars - dotlen)) len)

    # interior segment of a 3+ segment display
    else
        start = len / segmax | math.floor * (seg - 1)
        ret c.elipses | string.append (str | string.slice start (c.max_chars - 2*dotlen)) | string.append c.elipses
    end
end


# (alternate display) function to modify display interval of single frame text
func get_interval(str, segments)
    len = str | string.size
    interval = c.update_interval

    if segments == 1
        # display true single frame for time specified in config
        if (! c.padding) || (len == c.max_chars)
            # round to nearest multiple of update interval to match timers
            interval = c.static_interval - c.static_interval % c.update_interval
        # extend interval for 1-segment bounce
        else
            interval = interval * 3
        end
        # 2-segment bounces with an extra interval in get_secs, get_segment
    end
    ret interval
end


# (alternate display) function to get total # of display seconds
func get_secs(segs, interval)
    secs = segs * interval
    # add an extra interval to two-segment displays for time to bounce
    if segs == 2
        secs = secs + c.update_interval
    end
    ret secs
end

# add padding to single digit seconds
func pad_time(secs)
    ret (secs < 10) ? ("0" + secs) : secs
end

##
    END FUNCTIONS
##



# create a custom clock to disallow updates with < c.update_interval seconds left
# this prevents updates being sent too close to a refresh from a new song starting
safety_total_seconds = ActivityElapsedTotalSeconds | math.floor
safety_max = ActivityDurationTotalSeconds - c.update_interval
if (safety_total_seconds > safety_max)
    safety_total_seconds = safety_max
end
# round time with math.floor (not math.ceil) to prevent timing errors
safety_minutes = (safety_total_seconds / 60) | math.floor
safety_seconds = safety_total_seconds % 60


# set up track timers rounding seconds to the closest update interval
# offset by 1 so the clock starts at 0:01 instead of 0:00
if c.display_timers
    display_rounded_seconds = safety_seconds - (safety_seconds % c.update_interval) + 1
    display_elapsed = safety_minutes + ":" + pad_time(display_rounded_seconds) + " "
    display_total_minutes = ActivityDurationTotalSeconds / 60 | math.floor
    display_total_seconds = pad_time(ActivityDurationTotalSeconds % 60)
    display_total = " " + display_total_minutes + ":" + display_total_seconds
    c.pre_display = display_elapsed
    c.post_display = display_total
end


# generate artist and track title strings
space = replace_chars(" ")
message = replace_chars(c.custom_message)
artist = replace_chars(ActivityArtist)
track = replace_chars(ActivityTrackTitle)


# generate final scroll text
if c.infinite_scroll
    single_title =  artist + space*2 + track + space*3
    if c.enable_message
        single_title = c.custom_message + space*3 + single_title
    end
    scroll_title = single_title * 3
    cycle_length = single_title | string.size
    position = (((safety_total_seconds / c.update_interval) | math.floor) * c.chars_at_a_time) % cycle_length
    output = scroll_title | string.slice position c.max_chars

# generate final alternate text
else
    message_segs = seg_count(message)
    message_interval = get_interval(message, message_segs)
    message_secs = c.enable_message ? get_secs(message_segs, message_interval) : 0
    artist_segs = seg_count(artist)
    artist_interval = get_interval(artist, artist_segs)
    artist_secs = get_secs(artist_segs, artist_interval)
    track_segs = seg_count(track)
    track_interval = get_interval(track, track_segs)
    track_secs = get_secs(track_segs, track_interval)

    sec = safety_total_seconds % (message_secs + artist_secs + track_secs)
    if (sec < message_secs)
        seg = sec / message_interval | math.floor + 1
        output = get_segment(message, space, seg, message_segs, sec, message_secs)
    else if (sec < message_secs + artist_secs)
        sec = sec - message_secs
        seg = sec / artist_interval | math.floor + 1
        output = get_segment(artist, space, seg, artist_segs, sec, artist_secs)
    else
        sec = sec - message_secs - artist_secs
        seg = sec / track_interval  | math.floor + 1
        output = get_segment(track, space, seg, track_segs, sec, track_secs)
    end
end

# generate final output
output = c.pre_display + output + c.post_display
output | string.truncate 32
-}}
