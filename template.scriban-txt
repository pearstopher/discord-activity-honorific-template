{{-
##
    CONFIGURATION
##


# choose the maximum number of characters of song info to display
max_chars = 30
# *honorific supports a max of 32 total


# choose text to display to the ♪left and right♪ of the song info
pre_display = "♪"
post_display = "♪"

# or show progress timers for each song instead
display_timers = false
# *adds 10 characters when true (M:SS_ and _M:SS)


# choose how often to update the title in seconds
update_interval = 3
# *seems to work as low as 2 before it breaks for synced pairs
# *tested with Lightless


# choose between infinite scroll and alternate display
infinite_scroll = false
# *if true, display scrolls repeating artist and track name indefinitely
# *if false, alternates between artist and track names individually

# (infinite scroll only) choose how many characters to scroll at a time
chars_at_a_time = 2

# (alternate only) choose to pad short names with whitespace up to max_width
padding = true

# (alternate only) choose what type of elipses to display ("...", "", "…")
elipses = "..."
# *supports multiple characters but not 0 currently, cannot set to empty ""


# choose what type of character replacement you prefer if any
char_replace_type = "none"
# "none" =  PRO: standard font, supports all special characters
#           CON: not fixed width, updates change title size
#
# "block" = PRO: true fixed width display
#           CON: only supports uppercase letters and numbers
#
# "mono" =  PRO: supports upper- and lower-case letters
#           CON: not truly monospace as spaces are slightly too wide
#

# (block text only) replace spaces with empty block ■ if true
block_spaces = false



##
    DON'T EDIT BELOW THIS LINE UNLESS YOU KNOW WHAT YOU'RE DOING

    In which case, I'd love to see a pull request with your additions!
    https://github.com/pearstopher/discord-activity-honorific-template
##





##
    CROSS PLUGIN COMPATIBILITY
##

# determine which plugin is being used
if ! Activity.Popularity
    discord = true
end

# Shared Template Variables
# ActivityShared = Activity.Shared

# Plugin Specific Variables
if discord
    ActivityElapsedTotalSeconds = Activity.Elapsed.TotalSeconds
    ActivityDurationTotalSeconds = Activity.Duration.TotalSeconds | math.floor
    ActivityArtist = Activity.Artists[0]
    ActivityTrackTitle = Activity.TrackTitle
else
    # Context.SecsElapsed does not match Activity.Elapsed and is less reliable
    # It tracks the script context and is not related to Spotify at all
    # For example, if you pause a song and restart it the context restarts at 0
    ActivityElapsedTotalSeconds = Context.SecsElapsed
    ActivityDurationTotalSeconds = Activity.DurationMs / 1000 | math.floor
    ActivityArtist = Activity.Artists[0].Name
    ActivityTrackTitle = Activity.Name
end
# No template variables below this line


##
    FUNCTIONS
##


# (all) replace characters with monospaced or XIV block letters
# char_replace_type set in config, one of "none" "block" "mono"
func replace_chars(title)

    if char_replace_type == "none"
        ret title
    end

    mono_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz 0123456789"
    mono_chars = "ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ　０１２３４５６７８９"
    block_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789?"
    block_chars = "　"

    if char_replace_type == "mono"
        alphabet = mono_alphabet
        chars = mono_chars
    else if char_replace_type == "block"
        alphabet = block_alphabet
        chars = block_chars
        title = string.upcase title
        if block_spaces
            title = title | string.replace " " "■"
        end
    end

    # perform the character replacement
    result = ""
    for char in title
        index = alphabet | string.index_of char
        if index >= 0
            newchar = chars | string.slice index 1
            result = result + newchar
        end
    end

    ret result
end

# (alternate display) function to determine number of segments
func segments(str)
    len = str | string.size
    dotlen = elipses | string.size

    # 1 segment is up to max_chars characters
    if len <= max_chars
        ret 1
    # 2 segments are up to max_chars - dotlen characters each
    else if len <= 2*(max_chars - dotlen)
        ret 2
    # 3+ segments
    # first and last are max_chars - dotlen
    # middle segments are max_chars - 2dotlen
    else
        # subtract the first and last segments, count the middle segments, combine the two
        ret (len - 2*(max_chars - dotlen)) / (max_chars - 2*dotlen) | math.ceil + 2
    end
end

# (alternate display) function to get the correct segment text
func get_segment(str, seg, segmax, max_chars, elipses, padding, space, sec, maxsec)
    len = str | string.size
    dotlen = elipses | string.size

    if segmax == 1
        if (! padding) || (len == max_chars)
            ret str
        else
            # create before/after padding bounce
            pad_with = ""
            for i in 0..(max_chars - len - 1)
                pad_with = pad_with + space
            end
            interval = (maxsec / 3) | math.floor
            if (sec >= interval) && (sec < interval * 2)
                ret pad_with + str
            else
                ret str + pad_with
            end
        end
    else if seg == 1
        ret str | string.slice 0 (max_chars - dotlen) | string.append elipses
    else if seg == segmax
        ret elipses | string.append (str | string.slice (len - (max_chars - dotlen)) len)
    else
        start = len / segmax | math.floor * (seg - 1)
        ret elipses | string.append (str | string.slice start (max_chars - 2*dotlen)) | string.append elipses
    end
end

# function to correctly resize string
func resize(str, len, elipses)
    if (str | string.size > len)
        str = str | string.slice 0 (len - 1)
        str = str | string.append elipses
    end
    ret str
end

# function to extend length that a single frame title is displayed
func fair(update_interval, segments, padding, str, max_chars)
    len = str | string.size

    if segments == 1
        # display true single frame for twice as long
        if (! padding) || (len == max_chars)
            update_interval = update_interval * 2
        # display padded single frame for 3x as long
        # (time to bounce L - R - L)
        else
            update_interval = update_interval * 3
        end
    end
    ret update_interval
end

##
    END FUNCTIONS
##


# generate title and artist strings with spacing to separate cycles
sp = replace_chars(" ")
artist = replace_chars(ActivityArtist)
track = replace_chars(ActivityTrackTitle)
if infinite_scroll
    single_title = artist + sp + sp + track + sp + sp + sp
    full_title = single_title + single_title + single_title
end


# create a custom clock to disallow updates with < update_interval seconds left
# this prevents updates being sent too fast if the scroll updates immediately before a new song
safety_total_seconds = ActivityElapsedTotalSeconds | math.floor
safety_max = ActivityDurationTotalSeconds - update_interval
if (safety_total_seconds > safety_max)
    safety_total_seconds = safety_max
end
safety_minutes = (safety_total_seconds / 60) | math.floor
safety_seconds = safety_total_seconds % 60


# set up track timers in the format M:SS
# round seconds to the closest update interval
# offset by 1 so it starts at 0:01 instead of 0:00
elapsed_seconds = (safety_seconds - (safety_seconds % update_interval))  + 1
if elapsed_seconds < 10
    elapsed_seconds = "0" + elapsed_seconds
end
time_elapsed = safety_minutes | string.append ":" | string.append elapsed_seconds
time_total_minutes = ActivityDurationTotalSeconds / 60 | math.floor
time_total_seconds = ActivityDurationTotalSeconds % 60
if time_total_seconds < 10
    time_total_seconds = "0" + time_total_seconds
end
time_total = time_total_minutes | string.append ":" | string.append time_total_seconds


# ready to generate the actual text to display
if infinite_scroll

    # set up infinite scrolling
    scroll_title = full_title
    cycle_length = single_title | string.size
    position = (((safety_total_seconds / update_interval) | math.floor) * chars_at_a_time) % cycle_length
    scroll_title = scroll_title | string.slice position max_chars

else
    # get number of segments for each
    artist_segs = segments(artist)
    track_segs = segments(track)

    # calculate how long artist and track will be displayed based on frame count
    artist_secs = artist_segs * fair(update_interval, artist_segs, padding, artist, max_chars)
    track_secs = track_segs * fair(update_interval, track_segs, padding, track, max_chars)
    total_display_secs = artist_secs + track_secs

    # main display logic
    secs = safety_total_seconds % total_display_secs
    if (secs < artist_secs)
        fair_artist_secs = fair(update_interval, artist_segs, padding, artist, max_chars)
        segment = secs / fair_artist_secs | math.ceil
        scroll_title = get_segment(artist, segment, artist_segs, max_chars, elipses, padding, sp, secs, artist_secs)
    else
        secs = secs - artist_secs
        fair_track_secs = fair(update_interval, track_segs, padding, track, max_chars)
        segment = secs / fair_track_secs  | math.ceil
        scroll_title = get_segment(track, segment, track_segs, max_chars, elipses, padding, sp, secs, track_secs)
    end
end

# generate final output
if display_timers
    output = time_elapsed + " " + scroll_title + " " + time_total
else
    output = pre_display + scroll_title + post_display
end

output | string.truncate 32
-}}
