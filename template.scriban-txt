{{-
##
    CONFIGURATION
##

# length of scrolling characters
max_chars = 13
# honorific supports a max of 32

# display song timers
display_timers = false
# +10 to length when true (M:SS_ and _M:SS)
# +2 to length when false (♪ and ♪)

# update the title every X seconds
update_interval = 3
# seems to work as low as 2 before it breaks for synced pairs
# tested with Lightless

# scroll by X characters at a time
chars_at_a_time = 2

# enable infinite scroll
infinite_scroll = true
# if true, repeats artist and track name infinitely
# if false, alternates between artist and track names

# switch between artist and track every X updates
scroll_updates = 7

# type of character replacement
char_replace_type = "block"
# "none" = supports all characters, not fixed width
# "mono" = monospaced letters (upper-, lowercase, numbers, spaces slightly too wide)
# "block" = XIV block letters (uppercase, numbers) true fixed width
block_spaces = false
# for block text, replaces spaces with empty block ■ if true


##
    DON'T EDIT BELOW THIS LINE UNLESS YOU KNOW WHAT YOU'RE DOING

    In which case, I'd love to see a pull request with your additions!
    https://github.com/pearstopher/discord-activity-honorific-template
##




##
    CROSS PLUGIN COMPATIBILITY
##

# determine which plugin is being used
if ! Activity.Popularity
    discord = true
end

# Shared Template Variables
# ActivityShared = Activity.Shared

# Plugin Specific Variables
if discord
    ActivityElapsedTotalSeconds = Activity.Elapsed.TotalSeconds
    ActivityDurationTotalSeconds = Activity.Duration.TotalSeconds | math.floor
    ActivityArtist = Activity.Artists[0]
    ActivityTrackTitle = Activity.TrackTitle
else
    # Context.SecsElapsed does not match Activity.Elapsed and is less reliable
    # It tracks the script context and is not related to Spotify at all
    # For example, if you pause a song and restart it the context restarts at 0
    ActivityElapsedTotalSeconds = Context.SecsElapsed
    ActivityDurationTotalSeconds = Activity.DurationMs / 1000 | math.floor
    ActivityArtist = Activity.Artists[0].Name
    ActivityTrackTitle = Activity.Name
end
# No template variables below this line


##
    FUNCTIONS
##


# replace characters with XIV block letters
# char_replace_type set in config, one of "none" "block" "mono"
func replace_chars(title, type, block_spaces)

    if type == "none"
        ret title
    end

    # em space _ _ # displays in chat but not in honorific
    # ideographic space _　_  # slightly too long for monospace, appears equal in chat
    mono_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz 0123456789"
    mono_chars = "ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ　０１２３４５６７８９"
    block_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789?"
    block_chars = "　"

    if type == "mono"
        alphabet = mono_alphabet
        chars = mono_chars
    else if type == "block"
        alphabet = block_alphabet
        chars = block_chars
        title = string.upcase title
        if block_spaces
            title = title | string.replace " " "■"
        end
    end

    # perform the character replacement
    result = ""
    for char in title
        index = alphabet | string.index_of char
        if index >= 0
            newchar = chars | string.slice index 1
            result = result + newchar
        end
    end

    ret result
end


# generate title and artist strings with spacing to separate cycles
space = replace_chars(" ", char_replace_type, block_spaces)
artist = replace_chars(ActivityArtist, char_replace_type, block_spaces) + space + space
track = replace_chars(ActivityTrackTitle, char_replace_type, block_spaces)  + space + space
if infinite_scroll
    single_title = artist + track + space
    full_title = single_title + single_title + single_title
end


# create a custom clock to disallow updates with < update_interval seconds left
# this prevents updates being sent too fast if the scroll updates immediately before a new song
safety_total_seconds = ActivityElapsedTotalSeconds | math.floor
safety_max = ActivityDurationTotalSeconds - update_interval
if (safety_total_seconds > safety_max)
    safety_total_seconds = safety_max
end
safety_minutes = (safety_total_seconds / 60) | math.floor
safety_seconds = safety_total_seconds % 60


# set up track timers in the format M:SS
# round seconds to the closest update interval
# offset by 1 so it starts at 0:01 instead of 0:00
elapsed_seconds = (safety_seconds - (safety_seconds % update_interval))  + 1
if elapsed_seconds < 10
    elapsed_seconds = "0" + elapsed_seconds
end
time_elapsed = safety_minutes | string.append ":" | string.append elapsed_seconds
time_total_minutes = ActivityDurationTotalSeconds / 60 | math.floor
time_total_seconds = ActivityDurationTotalSeconds % 60
if time_total_seconds < 10
    time_total_seconds = "0" + time_total_seconds
end
time_total = time_total_minutes | string.append ":" | string.append time_total_seconds

if infinite_scroll
    # set up infinite scrolling
    scroll_title = full_title
    cycle_length = single_title | string.size
    position = (((safety_total_seconds / update_interval) | math.floor) * chars_at_a_time) % cycle_length
    scroll_title = scroll_title | string.slice position max_chars

else
    # set up separate scrolling logic
    scroll_artist = artist + artist + artist
    scroll_track = track + track + track
    artist_cycle = artist | string.size
    track_cycle = track | string.size

    # keep artist and track time separate to add cycles or edit times independently
    artist_time = update_interval * scroll_updates
    track_time = update_interval * scroll_updates
    total_time = artist_time + track_time
    phase = safety_total_seconds % total_time

    if phase < artist_time
        artist_position = (((phase / update_interval) | math.floor) * chars_at_a_time) % artist_cycle
        scroll_title = scroll_artist | string.slice artist_position max_chars

    else
        track_phase = phase - artist_time
        track_position = (((track_phase / update_interval) | math.floor) * chars_at_a_time) % track_cycle
        scroll_title = scroll_track | string.slice track_position max_chars

    end
end

# generate final output
if display_timers
    output = time_elapsed + " " + scroll_title + " " + time_total | string.truncate 32
else
    output = "♪" + scroll_title + "♪" | string.truncate 32
end

output
-}}
